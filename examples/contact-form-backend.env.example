# Environment for contact-form-backend. Copy to /etc/contact-form-backend.env,
# chmod 600, and fill in. Never commit the real file.
# Comments must be on their own lines: systemd and docker --env-file do not
# strip comments that follow a value.

CFB_CONFIG=/etc/contact-form-backend/forms.toml

# Signs the anti-spam tokens. Same value in every worker/server.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CFB_SECRET=change-me

# SMTP: your mail provider's submission server.
# CFB_SMTP_SECURITY is starttls (default, port 587), ssl (port 465) or none.
CFB_SMTP_HOST=smtp.example.ca
CFB_SMTP_PORT=587
CFB_SMTP_SECURITY=starttls
CFB_SMTP_USER=forms@example.ca
CFB_SMTP_PASSWORD=change-me
CFB_SMTP_TIMEOUT=15

# From must be an address on YOUR domain (SPF/DKIM); the visitor goes in Reply-To.
CFB_MAIL_FROM=Website <forms@example.ca>
# Comma-separated; a form's `to` list overrides it.
CFB_MAIL_TO=hello@example.ca

# Optional: signs webhook bodies (X-Contact-Form-Signature: sha256=...).
# CFB_WEBHOOK_SECRET=change-me
